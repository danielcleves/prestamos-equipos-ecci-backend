<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <!--
        force="true" es imprescindible al ejecutar dentro de Docker.
        docker-compose.yml define DB_CONNECTION, DB_DATABASE y APP_ENV como
        variables de entorno del contenedor, y PHPUnit NO sobrescribe una
        variable que ya existe a menos que se fuerce. Forzar DB_DATABASE=prestamos_test
        garantiza que la suite se ejecute en una base de datos aislada y RefreshDatabase
        nunca borre los datos de desarrollo (prestamos_equipos).

        DB_HOST, DB_PORT, DB_USERNAME y DB_PASSWORD no se fuerzan aqui: provienen
        del entorno del contenedor (prestamos_db:3306) o del archivo .env.
    -->
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="APP_LOCALE" value="es" force="true"/>
        <env name="APP_FALLBACK_LOCALE" value="en" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="prestamos_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
